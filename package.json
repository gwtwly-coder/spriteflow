{
  "name": "spriteflow",
  "version": "0.1.0",
  "private": true,
  "description": "SpriteFlow - browser-only sprite pipeline tool (M1). Static site, zero server, hosted on Cloudflare Pages.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "=24.12.0"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test:unit": "pnpm -r --if-present run test",
    "golden": "pnpm --filter @spriteflow/golden --if-present run golden",
    "build": "pnpm -r --if-present run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}

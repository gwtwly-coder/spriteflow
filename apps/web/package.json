{
  "name": "@spriteflow/web",
  "version": "0.1.0",
  "private": true,
  "description": "SpriteFlow browser app (React + Canvas2D + Zustand). Static Vite build deployed to Cloudflare Pages; all pixel work stays in the pipeline worker.",
  "type": "module",
  "dependencies": {
    "@spriteflow/pipeline": "workspace:*",
    "comlink": "4.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zundo": "2.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.1.2",
    "jsdom": "26.1.0",
    "vite": "7.3.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  }
}

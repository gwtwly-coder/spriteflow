# Kept for architecture-m1.md section 2 compliance and for npm (not pnpm) reading this file.
# pnpm >= 11 ignores .npmrc: the effective settings live in pnpm-workspace.yaml
# (autoInstallPeers=false, saveExact=true, engineStrict=true). Keep both in sync.
auto-install-peers=false
save-exact=true
engine-strict=true
